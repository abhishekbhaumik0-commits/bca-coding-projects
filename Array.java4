import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter rows: ");
        int r = sc.nextInt();

        System.out.print("Enter columns: ");
        int c = sc.nextInt();

        int a[][] = new int[r][c];

        System.out.println("Enter matrix elements:");

        for(int i = 0; i < r; i++) {
            for(int j = 0; j < c; j++) {
                a[i][j] = sc.nextInt();
            }
        }

        if(r == c) {
            int mainSum = 0;
            int secSum = 0;

            for(int i = 0; i < r; i++) {
                for(int j = 0; j < c; j++) {

                    if(i == j) {
                        mainSum += a[i][j];
                    }

                    if(i + j == r - 1) {
                        secSum += a[i][j];
                    }
                }
            }

            System.out.println("Main diagonal sum = " + mainSum);
            System.out.println("Secondary diagonal sum = " + secSum);

        } else {
            System.out.println("Diagonals are not defined for a non-square matrix.");
        }
    }
}
